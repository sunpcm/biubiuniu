{
  "name": "@sunpcm/niu-db",
  "version": "0.1.0-next.0",
  "description": "Explicit PostgreSQL connection factory (Drizzle ORM + postgres.js) with close lifecycle",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src --report-unused-disable-directives",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "@niu/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunpcm/biubiuniu.git",
    "directory": "packages/db"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prettier": "@sunpcm/niu-prettier-config"
}
