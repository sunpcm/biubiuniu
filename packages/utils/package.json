{
  "name": "@sunpcm/niu-utils",
  "version": "0.1.0-next.0",
  "description": "Framework-free formatting and data utilities for Nexty",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --report-unused-disable-directives",
    "test": "node --test ../../test/packages/utils.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunpcm/biubiuniu.git",
    "directory": "packages/utils"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "format",
    "utilities"
  ],
  "author": "",
  "license": "ISC",
  "prettier": "@sunpcm/niu-prettier-config"
}
