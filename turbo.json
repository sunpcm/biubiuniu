{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "strict",
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/packages/configs/**",
        "src/proxy.ts",
        "gtag.js",
        "next-env.d.ts",
        "src/config/**",
        "src/i18n/**",
        "src/styles/**",
        "scripts/**",
        "supabase/**"
      ],
      "env": [
        "ANALYZE",
        "DISABLE_AI",
        "DISABLE_NANO",
        "DISABLE_PURCHASE",
        "NANO_DISPATCH_BATCH_SIZE",
        "NANO_LEASE_MS",
        "NANO_MAX_CONCURRENT_DISPATCHES",
        "NANO_MODEL",
        "NANO_POLL_INTERVAL_MS",
        "NANO_PROVIDER_TIMEOUT_MS",
        "NANO_UNKNOWN_REFUND_AFTER_MS",
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "R2_PUBLIC_URL",
        "VERCEL_ENV"
      ],
      "passThroughEnv": [
        "ADMIN_EMAIL",
        "ADMIN_NAME",
        "ALLOWED_ORIGINS",
        "AWS_LAMBDA_FUNCTION_NAME",
        "BETTER_AUTH_SECRET",
        "CREEM_API_BASE_URL",
        "CREEM_API_KEY",
        "CREEM_WEBHOOK_SECRET",
        "CUSTOM_OPENAI_API_KEY",
        "CUSTOM_OPENAI_BASE_URL",
        "DATABASE_URL",
        "DISCORD_WEBHOOK_URL",
        "FAL_VERIFY_WEBHOOKS",
        "FIRECRAWL_API_KEY",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "JWT_AUDIENCE_LEARNER",
        "JWT_EXPIRES_IN",
        "JWT_ISSUER",
        "JWT_SECRET",
        "KIE_API_KEY",
        "KIE_WEBHOOK_HMAC_KEY",
        "NETLIFY",
        "OPENROUTER_API_KEY",
        "PLAUSIBLE_API_KEY",
        "PLAUSIBLE_URL",
        "R2_ACCESS_KEY_ID",
        "R2_ACCOUNT_ID",
        "R2_BUCKET_NAME",
        "R2_SECRET_ACCESS_KEY",
        "REPLICATE_API_TOKEN",
        "REPLICATE_WEBHOOK_SIGNING_SECRET",
        "RESEND_API_KEY",
        "STRIPE_CUSTOMER_PORTAL_URL",
        "STRIPE_RADAR_EARLY_FRAUD_WARNING_TYPE",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "TURNSTILE_SECRET_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "WEBHOOK_BASE_URL"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "stats.html"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/packages/configs/eslint-config/**"
      ],
      "env": ["NODE_ENV"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/packages/configs/tsconfig/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/turbo.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
