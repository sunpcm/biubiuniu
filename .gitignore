############################
# Dependencies
############################
node_modules/
**/**/node_modules

############################
# Build outputs
############################
dist/
build/
.next/
coverage/
*.tsbuildinfo

############################
# Caches (monorepo/tools)
############################
.turbo/
.webpack_cache/
.cache/
.parcel-cache/
.eslintcache

# Webpack 构建缓存 (FileSystem Cache)
.webpack_cache/

# Vite 预构建缓存 (如果之前没加)
.vite/

# ESLint 缓存 (如果你开了 --cache)
.eslintcache

# Turbo 缓存/输出 (虽然通常默认有，但检查一下)
.turbo/

# Stats reports (Vite build:analyze:vite)
stats.html
dist/stats.html

############################
# Logs
############################
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

############################
# OS / Editor
############################
.DS_Store
.idea/

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

############################
# Environment files
############################
# Ignore all environment files by default, including root/app/package variants.
# Safe templates remain checked in; never place credential values in them.
.env
.env.*
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample
!**/.env.example
!**/.env.sample
!**/.env.*.example
!**/.env.*.sample
