# Copy this file to apps/web/.env.local for local development.
# Keep all credential values in the ignored local file or deployment secret store.

# Build-visible values: changes can alter generated public output and the Turbo hash.
NODE_ENV=
ANALYZE=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BETTER_AUTH_URL=
NEXT_PUBLIC_DEFAULT_CURRENCY=
NEXT_PUBLIC_LOCALE_DETECTION=
NEXT_PUBLIC_LOGIN_MODE=
NEXT_PUBLIC_PRICING_PATH=
# Optional navigation override. Empty/unset falls back to /#pricing everywhere.
NEXT_PUBLIC_OPTIMIZED_IMAGES=
NEXT_PUBLIC_RATE_LIMIT_ENABLED=
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=
NEXT_PUBLIC_USER_SOURCE_TRACKING_ENABLED=
NEXT_PUBLIC_EMAIL_NORMALIZATION_ENABLED=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_RYBBIT_SRC=
NEXT_PUBLIC_RYBBIT_SITE_ID=
NEXT_PUBLIC_RYBBIT_SESSION_REPLAY=
NEXT_PUBLIC_RYBBIT_REPLAY_MASK_SELECTORS=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_TOLT_ID=
NEXT_PUBLIC_AI_MODEL_ID=
NEXT_PUBLIC_AI_PROVIDER=
NEXT_PUBLIC_CUSTOM_OPENAI_MODELS=
NEXT_PUBLIC_DISCORD_INVITE_URL=
R2_PUBLIC_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENABLE_PAYPAL=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=

# Runtime-only values: configure these only for the feature that needs them.
# Feature assembly switches (see src/config/features.ts). Purchase and AI are
# closed by default; set explicitly to "false" to re-enable once the durable-task
# contract (plan §5.4) ships.
DISABLE_PURCHASE=
DISABLE_AI=
